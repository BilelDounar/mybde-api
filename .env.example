# ─── PostgreSQL (données relationnelles) ──────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mybde_db"

# ─── MongoDB (actualités, messages, contenu) ──────────────
MONGODB_URI="mongodb://localhost:27017/mybde_content"

# ─── JWT ───────────────────────────────────────────────────
# IMPORTANT : >= 32 caractères, jamais la valeur par défaut (refusée au démarrage).
# Générer un secret robuste : `openssl rand -hex 48`
JWT_SECRET="remplacer-par-un-secret-robuste-de-32-caracteres-minimum"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Application ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Sécurité ──────────────────────────────────────────────
# Liste blanche des origines autorisées (CORS), séparées par des virgules.
ALLOWED_ORIGINS="http://localhost:8081,http://localhost:19006"
# Rate limiting global
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"

# ─── Stripe (billetterie) — NON IMPLÉMENTÉ (évolution future) ──
# Le paiement est actuellement simulé (l'Order est marqué COMPLETED sans appel
# Stripe). Ces variables sont réservées pour une intégration ultérieure.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Upload médias — NON IMPLÉMENTÉ (évolution future) ─────────
# Les images (événements, actus) sont fournies par URL. L'upload de fichiers
# n'est pas encore en place ; ces variables sont réservées pour plus tard.
# UPLOAD_DEST="./uploads"
# MAX_FILE_SIZE_MB=5
